export const createService = async (req, res) => {
  try {
    const { type } = req.params; // 'hotel', 'transportation', or 'guide'
    const Model = getModel(type);
    
    let images = [];
    if (req.files && req.files.length > 0) {
      images = req.files.map((file) => file.filename);
